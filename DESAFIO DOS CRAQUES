    let currentMode = '';
    let availableQuestions = [];
    let currentQuestion = null;
    let score = 0;
    let lives = 3;
    let level = 1;
    let timer = null;
    let timeLimit = 15;
    let penaltyPhase = 'kicker'; // 'kicker' ou 'keeper'

    function shuffle(array) {
      return array.sort(() => Math.random() - 0.5);
    }

    setTimeout(() => {
      document.getElementById("splashScreen").style.display = "none";
      document.getElementById("modeMenu").style.display = "flex";
    }, 5000);

    function startGame(mode) {
      currentMode = mode;
      score = 0;
      level = 1;

      document.getElementById("penaltyField").style.display = "none";
      document.getElementById("timerContainer").style.display = "block";

      if (mode === 'infinite') {
        lives = 3;
        timeLimit = 15;
        availableQuestions = shuffle([...infiniteData]);
        document.getElementById("levelContainer").style.display = "inline";
      } else if (mode === 'brasileirao') {
        lives = 1;
        timeLimit = 10;
        availableQuestions = shuffle([...brasileiraoData]);
        document.getElementById("levelContainer").style.display = "inline";
      } else if (mode === 'champions') {
        lives = 5;
        timeLimit = 10;
        availableQuestions = shuffle([...championsData]);
        document.getElementById("levelContainer").style.display = "none";
      } else if (mode === 'penalty') {
        lives = 3;
        document.getElementById("penaltyField").style.display = "block";
        document.getElementById("timerContainer").style.display = "none";
        document.getElementById("levelContainer").style.display = "none";
      }

      document.getElementById("modeMenu").style.display = "none";
      document.getElementById("gameInterface").style.display = "block";
      document.getElementById("scoreDisplay").textContent = score;

      updateLivesDisplay();

      if (mode === 'penalty') {
        window.addEventListener('keydown', handleKeyDefend);
        setupPenaltyRound();
      } else {
        loadNextQuestion();
      }
    }

    function updateLivesDisplay() {
      document.getElementById("livesDisplay").textContent = "❤️".repeat(Math.max(0, lives)) || "💀";
    }

    function startTimer() {
      clearInterval(timer);
      const timerBar = document.getElementById("timerBar");
      timerBar.style.width = "100%";

      const interval = 100;
      const totalTicks = (timeLimit * 1000) / interval;
      let ticks = 0;

      timer = setInterval(() => {
        ticks++;
        const percentage = 100 - (ticks / totalTicks) * 100;
        timerBar.style.width = Math.max(0, percentage) + "%";

        if (ticks >= totalTicks) {
          clearInterval(timer);
          handleTimeout();
        }
      }, interval);
    }

    function handleTimeout() {
      lives--;
      updateLivesDisplay();
      const resultMsg = document.getElementById("result-msg");
      resultMsg.textContent = "Tempo esgotado! Perdeu 1 vida.";
      resultMsg.style.color = "#f87171";

      if (lives <= 0) {
        gameOver();
      } else {
        setTimeout(loadNextQuestion, 1200);
      }
    }

    function loadNextQuestion() {
      const resultMsg = document.getElementById("result-msg");
      resultMsg.textContent = "";

      if (availableQuestions.length === 0) {
        if (currentMode === 'infinite') {
          availableQuestions = shuffle([...infiniteData]);
        } else {
          gameWin();
          return;
        }
      }

      currentQuestion = availableQuestions.pop();
      const optionsContainer = document.getElementById("optionsContainer");
      optionsContainer.innerHTML = "";

      let options = [];
      let correctAnswer = "";

      if (currentMode === 'infinite') {
        level = Math.floor(score / 30) + 1;
        document.getElementById("levelDisplay").textContent = level;
        timeLimit = Math.max(5, 15 - (level - 1) * 1);

        document.getElementById("nationText").textContent = currentQuestion.nation;
        document.getElementById("playerName").textContent = currentQuestion.name;
        document.getElementById("questionText").textContent = "Selecione o clube onde ele jogou mais vezes:";
        
        options = shuffle([...currentQuestion.teamOptions]);
        correctAnswer = currentQuestion.correctTeam;
      } else if (currentMode === 'brasileirao') {
        level = 38 - availableQuestions.length;
        document.getElementById("levelDisplay").textContent = `${level}/38`;

        document.getElementById("nationText").textContent = "DESCUBRA BRASILEIRÃO";
        document.getElementById("playerName").textContent = currentQuestion.name;
        document.getElementById("questionText").textContent = `Qual é o clube de ${currentQuestion.name}?`;

        options = shuffle([...currentQuestion.teamOptions]);
        correctAnswer = currentQuestion.correctTeam;
      } else {
        document.getElementById("nationText").textContent = currentQuestion.category;
        document.getElementById("playerName").textContent = currentQuestion.title;
        document.getElementById("questionText").textContent = currentQuestion.question;

        options = shuffle([...currentQuestion.options]);
        correctAnswer = currentQuestion.correctPlayer;
      }

      options.forEach(option => {
        const btn = document.createElement("button");
        btn.textContent = option;
        btn.onclick = () => checkAnswer(option, correctAnswer);
        optionsContainer.appendChild(btn);
      });

      startTimer();
    }

    function checkAnswer(selectedOption, correctAnswer) {
      clearInterval(timer);
      const resultMsg = document.getElementById("result-msg");

      if (selectedOption === correctAnswer) {
        score += 10;
        document.getElementById("scoreDisplay").textContent = score;
        resultMsg.textContent = "Acertou! Avançando...";
        resultMsg.style.color = "#4ade80";
        setTimeout(loadNextQuestion, 1000);
      } else {
        lives--;
        updateLivesDisplay();

        if (lives <= 0) {
          gameOver();
        } else {
          resultMsg.textContent = "Errou! Perdeu 1 vida.";
          resultMsg.style.color = "#f87171";
          setTimeout(loadNextQuestion, 1200);
        }
      }
    }

    /* --- LÓGICA DO MODO PÊNALTIS --- */
    function resetField() {
      const ball = document.getElementById("ball");
      const gk = document.getElementById("goalkeeper");
      ball.className = "ball pos-center";
      gk.className = "goalkeeper pos-center";
    }

    function setupPenaltyRound() {
      resetField();
      const resultMsg = document.getElementById("result-msg");
      resultMsg.textContent = "";
      const optionsContainer = document.getElementById("optionsContainer");
      optionsContainer.innerHTML = "";

      if (penaltyPhase === 'kicker') {
        document.getElementById("nationText").textContent = "Sua Vez de Chutar";
        document.getElementById("playerName").textContent = "VOCÊ É O BATEDOR ⚽";
        document.getElementById("questionText").textContent = "Escolha o canto para chutar a bola:";

        const sides = [
          { name: "Esquerda ⬅️", value: "left" },
          { name: "Centro ⬆️", value: "center" },
          { name: "Direita ➡️", value: "right" }
        ];

        sides.forEach(s => {
          const btn = document.createElement("button");
          btn.textContent = s.name;
          btn.onclick = () => shootPenalty(s.value);
          optionsContainer.appendChild(btn);
        });
      } else {
        document.getElementById("nationText").textContent = "Sua Vez de Defender";
        document.getElementById("playerName").textContent = "VOCÊ É O GOLEIRO 🧤";
        document.getElementById("questionText").textContent = "Use as SETAS do teclado (⬅️ ⬆️ ➡️) para saltar!";
      }
    }

    function shootPenalty(shotDirection) {
      const sides = ["left", "center", "right"];
      const gkDirection = sides[Math.floor(Math.random() * sides.length)];

      const ball = document.getElementById("ball");
      const gk = document.getElementById("goalkeeper");

      ball.className = `ball pos-${shotDirection} ball-shot`;
      gk.className = `goalkeeper pos-${gkDirection}`;

      const resultMsg = document.getElementById("result-msg");

      setTimeout(() => {
        if (shotDirection !== gkDirection) {
          score += 10;
          document.getElementById("scoreDisplay").textContent = score;
          resultMsg.textContent = "GOLAZO! Você marcou!";
          resultMsg.style.color = "#4ade80";
        } else {
          lives--;
          updateLivesDisplay();
          resultMsg.textContent = "DEFENDEU! O goleiro pegou seu chute!";
          resultMsg.style.color = "#f87171";
        }

        setTimeout(() => {
          if (lives <= 0) {
            gameOver();
          } else {
            penaltyPhase = 'keeper';
            setupPenaltyRound();
          }
        }, 1500);
      }, 400);
    }

    function handleKeyDefend(e) {
      if (currentMode !== 'penalty' || penaltyPhase !== 'keeper') return;

      let keeperJump = '';
      if (e.key === 'ArrowLeft') keeperJump = 'left';
      else if (e.key === 'ArrowUp') keeperJump = 'center';
      else if (e.key === 'ArrowRight') keeperJump = 'right';

      if (!keeperJump) return;

      const sides = ["left", "center", "right"];
      const shotDirection = sides[Math.floor(Math.random() * sides.length)];

      const ball = document.getElementById("ball");
      const gk = document.getElementById("goalkeeper");

      ball.className = `ball pos-${shotDirection} ball-shot`;
      gk.className = `goalkeeper pos-${keeperJump}`;

      const resultMsg = document.getElementById("result-msg");

      setTimeout(() => {
        if (keeperJump === shotDirection) {
          score += 10;
          document.getElementById("scoreDisplay").textContent = score;
          resultMsg.textContent = "DEFENDEU! Que grande defesa!";
          resultMsg.style.color = "#4ade80";
        } else {
          lives--;
          updateLivesDisplay();
          resultMsg.textContent = "GOL DO ADVERSÁRIO! Você pulou para o lado errado.";
          resultMsg.style.color = "#f87171";
        }

        setTimeout(() => {
          if (lives <= 0) {
            gameOver();
          } else {
            penaltyPhase = 'kicker';
            setupPenaltyRound();
          }
        }, 1500);
      }, 400);
    }

    function gameOver() {
      clearInterval(timer);
      window.removeEventListener('keydown', handleKeyDefend);
      document.getElementById("penaltyField").style.display = "none";
      document.getElementById("gameArea").innerHTML = `
        <h2 style="color: #f87171; margin-bottom: 5px;">FIM DE JOGO</h2>
        <p style="margin-bottom: 20px;">Sua Pontuação Final: <strong>${score} Pts</strong></p>
        <button onclick="returnToMenu()">Voltar ao Menu</button>
      `;
    }

    function gameWin() {
      clearInterval(timer);
      window.removeEventListener('keydown', handleKeyDefend);
      document.getElementById("penaltyField").style.display = "none";
      document.getElementById("gameArea").innerHTML = `
        <h2 style="color: #4ade80; margin-bottom: 5px;">PARABÉNS!</h2>
        <p style="margin-bottom: 20px;">Você respondeu a todas as perguntas!<br>Pontuação: <strong>${score} Pts</strong></p>
        <button onclick="returnToMenu()">Voltar ao Menu</button>
      `;
    }

    function returnToMenu() {
      location.reload();
    }
  </script>
</body>
</html>
