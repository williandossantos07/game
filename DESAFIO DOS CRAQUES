<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Desafio dos Craques do Futebol</title>
  <style>
    body {
      background-color: #0f172a;
      color: #fff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px 0;
      user-select: none;
    }
    .card {
      background-color: #1e293b;
      border: 2px solid #38bdf8;
      border-radius: 12px;
      padding: 25px;
      width: 420px;
      text-align: center;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      position: relative;
    }
    h1 {
      color: #38bdf8;
      font-size: 1.6rem;
      margin-bottom: 5px;
    }
    .subtitle {
      color: #94a3b8;
      font-size: 0.85rem;
      margin-bottom: 15px;
    }

    /* Tela de Abertura */
    #splashScreen {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 300px;
    }
    .loader {
      border: 4px solid #334155;
      border-top: 4px solid #38bdf8;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      animation: spin 1s linear infinite;
      margin-top: 20px;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Menu de Seleção */
    #modeMenu {
      display: none;
      flex-direction: column;
      gap: 15px;
      margin-top: 20px;
    }
    .mode-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    /* Interface do Jogo Quinta */
    #gameInterface {
      display: none;
    }
    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      font-size: 0.95rem;
      font-weight: bold;
    }
    .timer-bar-container {
      width: 100%;
      height: 8px;
      background-color: #334155;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 15px;
    }
    .timer-bar {
      height: 100%;
      width: 100%;
      background-color: #facc15;
      transition: width 0.1s linear;
    }
    .national-team {
      font-size: 0.9rem;
      color: #38bdf8;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .player-name {
      font-size: 1.8rem;
      font-weight: bold;
      color: #facc15;
      margin: 5px 0 10px 0;
    }
    .question {
      font-size: 0.95rem;
      color: #e2e8f0;
      margin-bottom: 15px;
    }
    .options {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    button {
      background-color: #334155;
      color: #fff;
      border: 1px solid #475569;
      padding: 12px;
      font-size: 1rem;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
      width: 100%;
    }
    button:hover {
      background-color: #475569;
      border-color: #38bdf8;
    }
    #result-msg {
      margin-top: 15px;
      font-weight: bold;
      min-height: 24px;
    }

    /* --- CAMPO DE FUTEBOL E PÊNALTIS --- */
    #penaltyField {
      display: none;
      position: relative;
      width: 100%;
      height: 240px;
      background: linear-gradient(to bottom, #15803d, #166534);
      border: 3px solid #fff;
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 15px;
    }
    .goal-post {
      position: absolute;
      top: 15px;
      left: 50%;
      transform: translateX(-50%);
      width: 220px;
      height: 90px;
      border: 5px solid #fff;
      border-bottom: none;
      background: rgba(255, 255, 255, 0.15);
    }
    .goalkeeper {
      position: absolute;
      top: 60px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 2.5rem;
      transition: all 0.4s ease-out;
    }
    .ball {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 2rem;
      transition: all 0.4s ease-out;
    }

    /* Animações das direções */
    .pos-left { left: 20% !important; }
    .pos-center { left: 50% !important; }
    .pos-right { left: 80% !important; }
    .ball-shot { top: 35px !important; }
  </style>
</head>
<body>

