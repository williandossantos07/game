    <!-- 3. Interface Principal do Jogo -->
    <div id="gameInterface">
      <div class="status-bar">
        <span>Vidas: <span id="livesDisplay"></span></span>
        <span id="levelContainer">Fase: <span id="levelDisplay" style="color:#facc15;">1</span></span>
        <span>Pontos: <span id="scoreDisplay" style="color: #38bdf8;">0</span></span>
      </div>

      <div class="timer-bar-container" id="timerContainer">
        <div id="timerBar" class="timer-bar"></div>
      </div>

      <!-- Arena de Pênaltis em CSS -->
      <div id="penaltyField">
        <div class="goal-post"></div>
        <div id="goalkeeper" class="goalkeeper">🧤</div>
        <div id="ball" class="ball">⚽</div>
      </div>

      <div id="gameArea">
